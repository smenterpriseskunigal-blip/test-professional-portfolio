generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL: Supabase *pooler* URL used by the running app (append ?pgbouncer=true&connection_limit=1 for port 6543).
// DIRECT_URL:   direct / session-mode URL used only by Prisma CLI commands (introspection, diff).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Content {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  body      String
  createdAt DateTime @default(now())
}

// Used for IP rate limiting (IPs are stored as hashes). Rows are cleaned up automatically.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

enum VisitorSessionStatus {
  AI_ACTIVE
  WAITING_FOR_ADMIN
  ADMIN_TAKEOVER
  CLOSED
}

model VisitorSession {
  id                  String               @id @default(cuid())
  fullName            String
  roleType            String
  source              String
  countryCode         String               @default("+91")
  mobile              String
  email               String
  emailVerified       Boolean              @default(false)
  status              VisitorSessionStatus @default(AI_ACTIVE)
  ipHash              String?
  userAgent           String?
  escalationStartedAt DateTime?
  escalationExpiresAt DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  messages            ChatMessage[]
  unansweredQuestions UnansweredQuestion[]

  @@index([status, updatedAt])
  @@index([email, createdAt])
}

model OtpVerification {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  lastSentAt DateTime  @default(now())
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

model ChatMessage {
  id        String         @id @default(cuid())
  sessionId String
  session   VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender    String // VISITOR | AI | ADMIN | SYSTEM
  body      String
  meta      Json?
  createdAt DateTime       @default(now())

  @@index([sessionId, createdAt])
}

model KnowledgeBaseItem {
  id        String   @id @default(cuid())
  category  String // QA | BIODATA | EXPERIENCE | LOCATION | INSTRUCTIONS
  title     String
  content   String
  tags      String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, active])
}

model UnansweredQuestion {
  id        String         @id @default(cuid())
  sessionId String
  session   VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question  String
  status    String         @default("PENDING") // PENDING | ADDED_TO_KB | DISMISSED
  answer    String?
  kbItemId  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status, createdAt])
}
