{
  "name": "yashwanth-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "hash": "node -e \"console.log(require('bcryptjs').hashSync(process.argv[1],12))\"",
    "db:check": "node --env-file=.env scripts/db-check.mjs",
    "db:diff": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --script"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@prisma/client": "5.22.0",
    "@react-pdf/renderer": "3.4.4",
    "bcryptjs": "2.4.3",
    "jose": "5.9.6",
    "lucide-react": "^1.77.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "prisma": "5.22.0",
    "typescript": "5.6.3",
    "@types/react": "18.3.12",
    "@types/node": "20.17.0",
    "@types/bcryptjs": "2.4.6"
  }
}
